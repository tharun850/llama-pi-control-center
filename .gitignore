# =========================================================================
# Llama Server & Pi Control Center .gitignore
# =========================================================================

# 1. Java & Maven artifacts
target/
*.class
*.jar
*.war
*.ear
.mvn/
*.nar

# 2. Node.js & Angular artifacts
node_modules/
frontend/node_modules/
.angular/
frontend/.angular/
dist/
frontend/dist/
.npm/
*.tsbuildinfo

# 3. Model Weights & Large Binary Files (Never commit weights to Git)
*.gguf
*.bin
*.safetensors
*.pt
*.onnx
*.weights

# 4. OS & Environment generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 5. Logs & Temporary Debug Files
*.log
*.tmp
*.temp
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 6. IDEs & Editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
